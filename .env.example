# Copie este arquivo para ".env" (mesma pasta) e preencha antes de rodar
# "docker compose up". NÃO suba o ".env" de verdade pro GitHub.

# Porta no SEU computador em que o site vai responder (http://localhost:PORTA).
PORTA_LOCAL=8080

# Senha para acessar o painel de moderação de divergências (/moderacao).
# OBRIGATÓRIO preencher. Gere uma senha forte e única — se você deixar o
# site acessível pela internet, essa senha é o que impede qualquer pessoa
# de confirmar/rejeitar relatos de divergência.
MODERACAO_SENHA=

# Segredo usado para assinar a sessão de moderação (string aleatória longa,
# ex.: gere uma com `openssl rand -hex 32`, ou qualquer gerador de senhas).
# OBRIGATÓRIO preencher.
SESSION_SECRET=

# ---------------------------------------------------------------------
# As variáveis abaixo só importam se você NÃO for usar o docker-compose.yml
# (ex.: rodando `npm run dev` direto, ou publicando num serviço de nuvem
# tipo Easypanel/Railway/Render com um Postgres externo).
# ---------------------------------------------------------------------

# URL do PostgreSQL (ex.: Supabase, Neon). Use o pooler de conexão (porta 6543
# no Supabase) e exija SSL.
# DATABASE_URL=postgresql://usuario:senha@host:6543/postgres?sslmode=require

# Porta HTTP do serviço, se não for usar o compose.
# PORT=8080
